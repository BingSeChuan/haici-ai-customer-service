# ========== 服务配置 ==========
APP_HOST=0.0.0.0
APP_PORT=8000

# ========== MySQL（与 docker-compose.yml 保持一致） ==========
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=haici
MYSQL_PASSWORD=haici_2026
MYSQL_DATABASE=haici_cs

# ========== JWT ==========
# 生产环境请替换为随机长字符串：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# ========== LLM（DeepSeek，OpenAI 兼容） ==========
# 在此填入你的 DeepSeek API Key（不要提交到仓库）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ========== Embedding ==========
# 可选值: local_bge（本地 bge-small-zh-v1.5，免注册默认）/ openai_compatible（任意兼容端点，如 SiliconFlow bge-m3）
EMBEDDING_PROVIDER=local_bge
# openai_compatible 模式下使用以下配置（SiliconFlow 示例：https://api.siliconflow.cn/v1，模型 BAAI/bge-m3）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# 本地模型下载镜像（中国大陆网络建议保持 hf-mirror.com）
HF_ENDPOINT=https://hf-mirror.com

# ========== RAG 参数 ==========
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.45
RAG_CONTEXT_BUDGET_CHARS=4000
RAG_HISTORY_ROUNDS=6
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ========== 业务规则 ==========
MAX_QUESTION_LENGTH=500
DAILY_QUESTION_LIMIT=100
FALLBACK_REPLY=抱歉，我在知识库中暂时没有找到与您的问题相关的信息。建议您换一种问法，或直接联系人工客服处理。

# ========== 数据目录 ==========
UPLOAD_DIR=./uploads
CHROMA_DIR=./chroma_data
SEED_DOCS_DIR=./data/seed_docs
